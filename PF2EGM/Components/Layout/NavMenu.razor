@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@using PF2EGM.Services
@inject IApiAuthService AuthService

@rendermode InteractiveServer

<LumexNavbar Height="4.5rem"
             Bordered="@true"
             Sticky="@true">

    @* Mobile: toggle on the left, brand beside it *@
    <LumexNavbarContent Class="lg:hidden">
        <LumexNavbarMenuToggle />
        <LumexNavbarBrand>
            <span class="nav-brand">
                <span class="nav-brand-mark">⬡</span>
                <span class="nav-brand-title">Roll Call</span>
            </span>
        </LumexNavbarBrand>
    </LumexNavbarContent>

    @* Desktop: brand on its own *@
    <LumexNavbarBrand Class="hidden lg:flex">
        <span class="nav-brand">
            <span class="nav-brand-mark">⬡</span>
            <span class="nav-brand-title">Roll Call</span>
        </span>
    </LumexNavbarBrand>

    @* Desktop nav links *@
    <LumexNavbarContent Class="hidden lg:flex gap-4">
        <LumexNavbarItem>
            <LumexLink Href="/" Class="text-white hover:text-amber-400 transition-colors">
                Home
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/create-character" Class="text-white hover:text-amber-400 transition-colors">
                Create Character
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/saved-characters" Class="text-white hover:text-amber-400 transition-colors">
                Saved Characters
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/campaigns" Class="text-white hover:text-amber-400 transition-colors">
                Campaigns
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/tutorials" Class="text-white hover:text-amber-400 transition-colors">
                Tutorials
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>

    <LumexNavbarContent Align="@Align.End" Class="hidden lg:flex">
        <LumexNavbarItem>
                @if (isAuthenticated)
                {
                    <LumexButton Size="@Size.Small"
                                Color="@ThemeColor.Primary"
                                Variant="@Variant.Flat">
                        <LumexLink Href="/account" Class="text-white">
                            My Account
                        </LumexLink>
                    </LumexButton>
                }
                else
                {
                    <LumexButton Size="@Size.Small"
                                Color="@ThemeColor.Primary"
                                Variant="@Variant.Flat">
                        <LumexLink Href="/login" Class="text-white">
                            Log In
                        </LumexLink>
                    </LumexButton>
                }
            </LumexNavbarItem>
    </LumexNavbarContent>

    @* Mobile slide-down menu *@
    <LumexNavbarMenu Class="lg:hidden">
        <LumexNavbarMenuItem>
            <LumexLink Href="/" Color="@ThemeColor.None" Class="w-full">Home</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/create-character" Color="@ThemeColor.None" Class="w-full">Create Character</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/saved-characters" Color="@ThemeColor.None" Class="w-full">Saved Characters</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/campaigns" Color="@ThemeColor.None" Class="w-full">Campaigns</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/tutorials" Color="@ThemeColor.None" Class="w-full">Tutorials</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarItem>
            @if (isAuthenticated)
            {
                <LumexButton Size="@Size.Small"
                            Color="@ThemeColor.Primary"
                            Variant="@Variant.Flat">
                    <LumexLink Href="/account" Class="text-white">
                        My Account
                    </LumexLink>
                </LumexButton>
            }
            else
            {
                <LumexButton Size="@Size.Small"
                            Color="@ThemeColor.Primary"
                            Variant="@Variant.Flat">
                    <LumexLink Href="/login" Class="text-white">
                        Log In
                    </LumexLink>
                </LumexButton>
            }
        </LumexNavbarItem>
    </LumexNavbarMenu>

</LumexNavbar>

@code {
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }
}

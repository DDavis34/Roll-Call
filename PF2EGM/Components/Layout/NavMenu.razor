@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@using PF2EGM.Services
@inject IApiAuthService AuthService

@rendermode InteractiveServer

<LumexNavbar Height="4.5rem"
             Bordered="@true"
             Sticky="@true">

    @* Mobile: toggle absolutely positioned left, brand centered *@
    <LumexNavbarContent Class="md:hidden w-full">
        <div class="relative flex items-center justify-center w-full">
            <LumexNavbarMenuToggle Class="absolute left-0" />
            <span class="flex items-center gap-2">
                <span class="text-2xl">⬡</span>
                <span class="text-2xl font-bold text-amber-400">Roll Call</span>
            </span>
        </div>
    </LumexNavbarContent>

    @* Desktop: brand on its own *@
    <LumexNavbarBrand Class="hidden md:flex">
        <span class="flex items-center gap-2">
            <span class="text-2xl">⬡</span>
            <span class="text-2xl font-bold text-amber-400">Roll Call</span>
        </span>
    </LumexNavbarBrand>

    @* Desktop nav links *@
    <LumexNavbarContent Class="hidden md:flex gap-4">
        <LumexNavbarItem>
            <LumexLink Href="/" Class="text-white hover:text-amber-400 transition-colors">
                Home
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/create-character" Class="text-white hover:text-amber-400 transition-colors">
                Create Character
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/saved-characters" Class="text-white hover:text-amber-400 transition-colors">
                Saved Characters
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/campaigns" Class="text-white hover:text-amber-400 transition-colors">
                Campaigns
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/tutorials" Class="text-white hover:text-amber-400 transition-colors">
                Tutorials
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>

    @* Auth button — right-aligned on all screen sizes *@
    <LumexNavbarContent Align="@Align.End" Class="hidden md:flex">
        <LumexNavbarItem>
            @if (isAuthenticated)
            {
                <LumexButton Size="@Size.Small"
                             Color="@ThemeColor.Primary"
                             Variant="@Variant.Shadow">
                    Account
                </LumexButton>
            }
            else
            {
                <LumexButton Size="@Size.Small"
                             Color="@ThemeColor.Primary"
                             Variant="@Variant.Shadow">
                    <a href="/login" class="text-black">
                        Log In
                    </a>
                </LumexButton>
            }
        </LumexNavbarItem>
    </LumexNavbarContent>

    @* Mobile slide-down menu *@
    <LumexNavbarMenu Class="md:hidden">
        <LumexNavbarMenuItem>
            <LumexLink Href="/" Class="w-full hover:text-amber-400">Home</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/create-character" Class="w-full hover:text-amber-400">Create Character</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/saved-characters" Class="w-full hover:text-amber-400">Saved Characters</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/campaigns" Class="w-full hover:text-amber-400">Campaigns</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            <LumexLink Href="/tutorials" Class="w-full hover:text-amber-400">Tutorials</LumexLink>
        </LumexNavbarMenuItem>
        <LumexNavbarMenuItem>
            @if (isAuthenticated)
            {
                <LumexButton Href="/account"
                            Size="@Size.Small"
                            Color="@ThemeColor.Primary"
                            Variant="@Variant.Shadow">
                    Account
                </LumexButton>
            }
            else
            {
                <LumexButton Href="/login"
                            Size="@Size.Small"
                            Color="@ThemeColor.Primary"
                            Variant="@Variant.Shadow">
                    Log In
                </LumexButton>
            }
        </LumexNavbarMenuItem>
    </LumexNavbarMenu>

</LumexNavbar>

@code {
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }
}
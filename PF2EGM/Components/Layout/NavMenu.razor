@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@using PF2EGM.Services
@inject IApiAuthService AuthService

@rendermode InteractiveServer

<LumexNavbar Height="4.5rem"
             Bordered="@true"
             Sticky="@true">
    <LumexNavbarBrand>
        <span class="flex items-center gap-2">
            <a href="/">
                <span class="nav-brand-mark text-2xl">⬡</span>
                <span class="text-2xl font-bold text-amber-400">Roll Call</span>
            </a>
        </span>
    </LumexNavbarBrand>

    @* Visible at lg (1024px) and above *@
    <LumexNavbarContent Class="hidden lg:flex gap-4">
        <LumexNavbarItem>
            <LumexLink Href="/" Class="text-white hover:text-amber-400 transition-colors">
                Home
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/create-character" Class="text-white hover:text-amber-400 transition-colors">
                Create Character
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/saved-characters" Class="text-white hover:text-amber-400 transition-colors">
                Saved Characters
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/campaigns" Class="text-white hover:text-amber-400 transition-colors">
                Campaigns
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/tutorials" Class="text-white hover:text-amber-400 transition-colors">
                Tutorials
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/account" Class="text-white hover:text-amber-400 transition-colors">
                Account
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>

    @* Right-side content: Account/Auth button or hamburger, depending on screen size *@
    <LumexNavbarContent Align="@Align.End">

        @* Account/Auth: visible at lg and above *@
        <LumexNavbarItem Class="hidden lg:flex">
            @if (isAuthenticated)
            {
                <LumexButton Size="@Size.Small"
                             Color="@ThemeColor.Primary"
                             Variant="@Variant.Flat">
                    <LumexLink Href="/account" Class="text-white">
                        Account
                    </LumexLink>
                </LumexButton>
            }
            else
            {
                <LumexButton Size="@Size.Small"
                             Color="@ThemeColor.Primary"
                             Variant="@Variant.Flat">
                    <LumexLink Href="/login" Class="text-white">
                        Log In
                    </LumexLink>
                </LumexButton>
            }
        </LumexNavbarItem>

        @* Hamburger button: visible below lg *@
        <LumexNavbarItem Class="flex lg:hidden">
            <button @onclick="ToggleMenu"
                    class="text-white hover:text-amber-400 transition-colors p-2 focus:outline-none"
                    aria-label="Toggle navigation menu"
                    aria-expanded="@menuOpen">
                @if (menuOpen)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                }
            </button>
        </LumexNavbarItem>

    </LumexNavbarContent>
</LumexNavbar>

@* Dropdown menu rendered below the navbar when open *@
@if (menuOpen)
{
    <div class="lg:hidden fixed top-[4.5rem] left-0 right-0 z-50 bg-background border-b border-divider shadow-md flex flex-col px-4 py-3 gap-1">
        <a href="/" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Home
        </a>
        <a href="/create-character" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Create Character
        </a>
        <a href="/saved-characters" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Saved Characters
        </a>
        <a href="/campaigns" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Campaigns
        </a>
        <a href="/tutorials" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Tutorials
        </a>
        <a href="/account" class="text-white hover:text-amber-400 transition-colors py-2 px-3 rounded hover:bg-white/5" @onclick="CloseMenu">
            Account
        </a>
        <div class="pt-2 border-t border-divider mt-1">
            @if (isAuthenticated)
            {
                <a href="/account" class="block w-full text-center bg-primary/20 text-white hover:bg-primary/30 transition-colors py-2 px-3 rounded" @onclick="CloseMenu">
                    Account
                </a>
            }
            else
            {
                <a href="/login" class="block w-full text-center bg-primary/20 text-white hover:bg-primary/30 transition-colors py-2 px-3 rounded" @onclick="CloseMenu">
                    Log In
                </a>
            }
        </div>
    </div>
}

@code {
    private bool isAuthenticated;
    private bool menuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
}

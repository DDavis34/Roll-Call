@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

<LumexNavbar Height="6rem"
             Bordered="@true"
             Sticky="@true">
    <LumexNavbarBrand>
        <span class="text-2xl font-bold text-amber-400">
            Roll Call
        </span>
    </LumexNavbarBrand>

    <LumexNavbarContent Class="hidden sm:flex">
        <LumexNavbarItem>
            <LumexLink Href="/"
                       Color="@ThemeColor.Primary">
                Home
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/create-character"
                       Color="@ThemeColor.Primary">
                Create Character
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/saved-characters"
                       Color="@ThemeColor.Primary">
                Saved Characters
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/campaigns"
                       Color="@ThemeColor.Primary">
                Campaigns
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/tutorials"
                       Color="@ThemeColor.Primary">
                Tutorials
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/account"
                       Color="@ThemeColor.Primary">
                Account
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>

    <LumexNavbarContent Align="@Align.End">
        <LumexNavbarItem>
            <LumexButton Size="@Size.Small"
                         Color="@ThemeColor.Primary"
                         Variant="@Variant.Flat">
                @* @if (User.Identity.IsAuthenticated) {
                    <span>Welcome, @User.Identity.Name!</span>
                } else {
                    <LumexLink Href="/login" Color="@ThemeColor.None">
                        Log In
                    </LumexLink>
                } *@
                <LumexLink Href="/login"
                           Color="@ThemeColor.None">
                    Log In
                </LumexLink>
            </LumexButton>
        </LumexNavbarItem>
    </LumexNavbarContent>
</LumexNavbar>
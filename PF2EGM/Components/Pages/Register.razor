@page "/register"
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using PF2EGM.Services
@using LumexUI
@inject IApiAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Create Account</PageTitle>

<div class="auth-wrapper">
    <LumexCard Class="auth-card">
        <LumexCardHeader Class="flex flex-col items-center gap-1 pb-2">
            <div class="brand-mark">⬡</div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Create account</h1>
            <p class="text-sm text-default-500">Join us today</p>
        </LumexCardHeader>

        <LumexCardBody Class="gap-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="flex items-center gap-2 rounded-xl bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger">
                    <span class="shrink-0 font-bold">!</span>
                    @errorMessage
                </div>
            }

            @if (registrationSuccess)
            {
                <div class="flex items-center gap-2 rounded-xl bg-success-50 border border-success-200 px-4 py-3 text-sm text-success">
                    <span class="shrink-0 font-bold">✓</span>
                    Account created! Check your email to confirm your address.
                </div>
            }
            else
            {
                <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="register">
                    <DataAnnotationsValidator />

                    <div class="flex flex-col gap-4">
                        <LumexTextbox @bind-Value="registerModel.Email"
                                      Type="@InputType.Email"
                                      Label="Email"
                                      Placeholder="you@example.com"
                                      Variant="@InputVariant.Flat"
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Required="@true"
                                      ErrorMessage="@emailError"
                                      Invalid="@(!string.IsNullOrEmpty(emailError))" />

                        <LumexTextbox @bind-Value="registerModel.Password"
                                      Type="@InputType.Password"
                                      Label="Password"
                                      Placeholder="••••••••"
                                      Variant="@InputVariant.Flat"
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Required="@true"
                                      ErrorMessage="@passwordError"
                                      Invalid="@(!string.IsNullOrEmpty(passwordError))" />

                        <LumexTextbox @bind-Value="registerModel.ConfirmPassword"
                                      Type="@InputType.Password"
                                      Label="Confirm Password"
                                      Placeholder="••••••••"
                                      Variant="@InputVariant.Flat"
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Required="@true"
                                      ErrorMessage="@confirmError"
                                      Invalid="@(!string.IsNullOrEmpty(confirmError))" />

                        <LumexButton Type="@ButtonType.Submit"
                                     Color="@ThemeColor.Primary"
                                     Class="w-full"
                                     Disabled="@isLoading">
                            @if (isLoading)
                            {
                                <LumexSpinner Size="@Size.Small" Color="@ThemeColor.Current" />
                                <span>Creating account…</span>
                            }
                            else
                            {
                                <span>Create account</span>
                            }
                        </LumexButton>
                    </div>
                </EditForm>

                <div class="flex items-center gap-3">
                    <LumexDivider Class="flex-1" />
                    <span class="text-xs text-default-400">or</span>
                    <LumexDivider Class="flex-1" />
                </div>

                <LumexButton Variant="@ButtonVariant.Outlined"
                             Class="w-full"
                             OnClick="HandleGoogleLogin">
                    <svg width="18" height="18" viewBox="0 0 18 18" class="shrink-0">
                        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                        <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.348 2.825.957 4.039l3.007-2.332z"/>
                        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
                    </svg>
                    Continue with Google
                </LumexButton>
            }
        </LumexCardBody>

        <LumexCardFooter Class="justify-center pt-0">
            <p class="text-sm text-default-500">
                Already have an account?
                <a href="/login" class="text-primary font-medium hover:opacity-75 transition-opacity">Sign in</a>
            </p>
        </LumexCardFooter>
    </LumexCard>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterModel registerModel { get; set; } = new();

    private string? errorMessage;
    private string? emailError;
    private string? passwordError;
    private string? confirmError;
    private bool isLoading = false;
    private bool registrationSuccess = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        emailError = null;
        passwordError = null;
        confirmError = null;

        if (string.IsNullOrEmpty(registerModel.Email))
            emailError = "Email is required";
        else if (!registerModel.Email.Contains('@'))
            emailError = "Enter a valid email";

        if (string.IsNullOrEmpty(registerModel.Password))
            passwordError = "Password is required";
        else if (registerModel.Password.Length < 8)
            passwordError = "Password must be at least 8 characters";

        if (string.IsNullOrEmpty(registerModel.ConfirmPassword))
            confirmError = "Please confirm your password";
        else if (registerModel.Password != registerModel.ConfirmPassword)
            confirmError = "Passwords do not match";

        if (emailError != null || passwordError != null || confirmError != null)
        {
            isLoading = false;
            return;
        }

        try
        {
            var result = await AuthService.SignUpAsync(registerModel.Email, registerModel.Password);

            if (result.IsSuccess)
                registrationSuccess = true;
            else
                errorMessage = result.ErrorMessage ?? "Registration failed. Please try again.";
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong. Please try again.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        var url = await AuthService.GetOAuthUrlAsync("google");
        Nav.NavigateTo(url, forceLoad: true);
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}
@page "/CharacterCreation"

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Character Creator</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 font-sans">
    <!-- Header -->
    <section class="text-center py-12">
        <h2 class="text-4xl font-extrabold text-amber-400 mb-4">Create Your Character</h2>
        <p class="text-gray-300">Build your hero by selecting race, class, and attributes.</p>
    </section>

    <!-- Form Section -->
    <section class="max-w-5xl mx-auto bg-gray-800 p-8 rounded-2xl shadow-lg">
        <form method="post" class="space-y-8">

            <!-- Basic Info -->
            <div>
                <h3 class="text-2xl font-semibold text-amber-400 mb-4">Basic Information</h3>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block mb-2">Character Name</label>
                        <input type="text" name="Name" class="w-full p-3 rounded-lg bg-gray-700 border border-gray-600 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block mb-2">Race</label>
                        <select name="Race" class="w-full p-3 rounded-lg bg-gray-700 border border-gray-600">
                            <option>Human</option>
                            <option>Elf</option>
                            <option>Dwarf</option>
                            <option>Halfling</option>
                            <option>Orc</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Class Selection -->
            <div>
                <h3 class="text-2xl font-semibold text-amber-400 mb-4">Class</h3>
                <select name="Class" class="w-full p-3 rounded-lg bg-gray-700 border border-gray-600">
                    <option>Fighter</option>
                    <option>Wizard</option>
                    <option>Rogue</option>
                    <option>Cleric</option>
                    <option>Ranger</option>
                </select>
            </div>

            <!-- Attributes -->
            <div>
                <h3 class="text-2xl font-semibold text-amber-400 mb-4">Attributes</h3>
                <div class="grid md:grid-cols-3 gap-6">
                    <div>
                        <label>Strength</label>
                        <input type="number" name="Strength" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                    <div>
                        <label>Dexterity</label>
                        <input type="number" name="Dexterity" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                    <div>
                        <label>Constitution</label>
                        <input type="number" name="Constitution" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                    <div>
                        <label>Intelligence</label>
                        <input type="number" name="Intelligence" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                    <div>
                        <label>Wisdom</label>
                        <input type="number" name="Wisdom" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                    <div>
                        <label>Charisma</label>
                        <input type="number" name="Charisma" min="1" max="20" class="w-full p-2 rounded bg-gray-700 border border-gray-600" />
                    </div>
                </div>
            </div>

            <!-- Equipment -->
            <div>
                <h3 class="text-2xl font-semibold text-amber-400 mb-4">Starting Equipment</h3>
                <textarea name="Equipment" rows="4" class="w-full p-3 rounded-lg bg-gray-700 border border-gray-600" placeholder="Describe your starting gear..."></textarea>
            </div>

            <!-- Submit -->
            <div class="text-center">
                <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 px-8 rounded-2xl shadow-lg transition">
                    Save Character
                </button>
            </div>

        </form>
    </section>
</body>
</html>

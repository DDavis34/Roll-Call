@code {
    [Parameter]
    public Guid? CharacterId { get; set; }

    private Guid? characterId;
    private bool isSaving;
    private bool saveStatusIsError;
    private string? saveStatusMessage;

    // ── Widget system ──────────────────────────────────────────────────────
    private bool widgetMode;
    private bool showCustomizePanel;
    private DotNetObjectReference<CharacterCreation>? _dotnetRef;

    private Dictionary<string, WidgetState> widgetStates = new()
    {
        ["combat-stats"]        = new() { X = 0,   Y = 0,   Width = 960 },
        ["background-leveling"] = new() { X = 0,   Y = 160, Width = 320 },
        ["skills-panel"]        = new() { X = 320, Y = 160, Width = 320 },
        ["weapons-gear"]        = new() { X = 640, Y = 160, Width = 480 },
    };

    private Dictionary<string, string> widgetLabels = new()
    {
        ["combat-stats"]        = "Combat Stats",
        ["background-leveling"] = "Background & Leveling",
        ["skills-panel"]        = "Skills & Stats",
        ["weapons-gear"]        = "Weapons & Gear",
    };

    private async Task ToggleWidgetMode()
    {
        widgetMode = !widgetMode;
        showCustomizePanel = false;
        if (widgetMode)
        {
            _dotnetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("widgetDrag.init", _dotnetRef);
        }
    }

    private void ToggleWidgetVisible(string id)
    {
        if (widgetStates.TryGetValue(id, out var ws))
            ws.Visible = !ws.Visible;
    }

    private void HideWidget(string id)
    {
        if (widgetStates.TryGetValue(id, out var ws))
            ws.Visible = false;
    }

    private void ResetWidgetPositions()
    {
        widgetStates["combat-stats"]        = new() { X = 0,   Y = 0,   Width = 960 };
        widgetStates["background-leveling"] = new() { X = 0,   Y = 160, Width = 320 };
        widgetStates["skills-panel"]        = new() { X = 320, Y = 160, Width = 320 };
        widgetStates["weapons-gear"]        = new() { X = 640, Y = 160, Width = 480 };
    }

    [JSInvokable]
    public void OnWidgetMoved(string widgetId, double x, double y)
    {
        if (widgetStates.TryGetValue(widgetId, out var ws))
        {
            ws.X = x;
            ws.Y = y;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotnetRef?.Dispose();
        await JS.InvokeVoidAsync("widgetDrag.dispose");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CharacterId != characterId)
        {
            characterId = CharacterId;
            saveStatusMessage = null;

            if (characterId.HasValue)
            {
                await LoadSavedCharacterAsync(characterId.Value);
            }
        }
    }

    private async Task LoadSavedCharacterAsync(Guid id)
    {
        if (!SessionStore.IsAuthenticated)
        {
            saveStatusIsError = true;
            saveStatusMessage = "Log in to load this saved character.";
            return;
        }

        var savedCharacter = await CharacterService.GetSavedCharacterAsync(id);
        if (savedCharacter is null)
        {
            saveStatusIsError = true;
            saveStatusMessage = "Could not load the requested saved character.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(savedCharacter.Data))
        {
            try
            {
                var deserialized = JsonSerializer.Deserialize<CharacterData>(savedCharacter.Data, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (deserialized is not null)
                {
                    character = deserialized;
                }
            }
            catch
            {
                saveStatusIsError = true;
                saveStatusMessage = "Saved character data could not be loaded.";
                return;
            }
        }

        character.Name = savedCharacter.Name;
        character.Ancestry = savedCharacter.Ancestry ?? character.Ancestry;
        character.Class = savedCharacter.CharacterClass ?? character.Class;
        character.Level = savedCharacter.Level;

        saveStatusIsError = false;
        saveStatusMessage = $"Loaded saved character: {DisplayName(savedCharacter.Name)}.";
    }

    private async Task SaveCharacterAsync()
    {
        saveStatusMessage = null;
        isSaving = true;

        try
        {
            var request = new SaveCharacterRequest(
                character.Name,
                character.Ancestry,
                character.Class,
                character.Level,
                JsonSerializer.Serialize(character, new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                }));

            var result = await CharacterService.SaveCharacterAsync(request, characterId);
            if (result.IsSuccess)
            {
                if (result.Character?.Id is { } savedId)
                {
                    characterId = savedId;
                    Nav.NavigateTo($"/create-character/{savedId}", replace: true);
                }

                saveStatusIsError = false;
                saveStatusMessage = "Character saved successfully.";
            }
            else
            {
                saveStatusIsError = true;
                saveStatusMessage = result.ErrorMessage ?? "Could not save the character right now.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string DisplayName(string? name) => string.IsNullOrWhiteSpace(name) ? "Untitled Character" : name;

    // ── Tab state ──────────────────────────────────────────────────────────

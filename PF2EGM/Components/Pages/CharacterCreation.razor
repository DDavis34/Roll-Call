    // ── Model classes ──────────────────────────────────────────────────────
    public class CharacterData
    {
        public int Level { get; set; }
        public int XP { get; set; }
        public string Name { get; set; } = "";
        public string Size { get; set; } = "Medium";
        public string Speed { get; set; } = "25ft";
        public string Ancestry { get; set; } = "";
        public string Background { get; set; } = "";
        public string Class { get; set; } = "";
        public int HeroPoints { get; set; }
        public int FighterDC { get; set; }
        public int Perception { get; set; }
        public int Initiative { get; set; }
        public int AC { get; set; }
        public int HP { get; set; }
        public int MaxHP { get; set; }
        public List<AbilityScore> Abilities { get; set; } = new();
        public List<SaveData> Saves { get; set; } = new();
        public List<SkillData> Skills { get; set; } = new();
    }

    public class AbilityScore   { public string Abbreviation { get; set; } = ""; public int Score { get; set; } public int Modifier { get; set; } }
    public class SaveData       { public string Name { get; set; } = ""; public int Modifier { get; set; } }
    public class SkillData      { public string Name { get; set; } = ""; public int Modifier { get; set; } public bool Trained { get; set; } public string ProficiencyLetter { get; set; } = ""; }
    public class WeaponData     { public string Name { get; set; } = ""; public string Damage { get; set; } = ""; public int AttackBonus { get; set; } public string Traits { get; set; } = ""; }
    public class ArmorData      { public string Name { get; set; } = ""; public int ACBonus { get; set; } public string Category { get; set; } = "Medium Armor"; }
    public class GearItem       { public string Name { get; set; } = ""; public int Quantity { get; set; } = 1; public decimal Weight { get; set; } }
    public class SpellEntry     { public string Name { get; set; } = ""; public int Level { get; set; } public string School { get; set; } = ""; public string CastTime { get; set; } = ""; public string Description { get; set; } = ""; }
    public class FeatEntry      { public string Name { get; set; } = ""; public string Description { get; set; } = ""; }
    public class ActionEntry    { public string Name { get; set; } = ""; public string ActionCost { get; set; } = ""; public string Traits { get; set; } = ""; public string Description { get; set; } = ""; }
    public class ActionSection  { public string Title { get; set; } = ""; public List<ActionEntry> Actions { get; set; } = new(); }
    public class CurrencyEntry  { public string Name { get; set; } = ""; public string Abbr { get; set; } = ""; public string Color { get; set; } = ""; public int Amount { get; set; } }
    public class CharacterDetails
    {
        public string Age { get; set; } = "";
        public string Gender { get; set; } = "";
        public string Height { get; set; } = "";
        public string Weight { get; set; } = "";
        public string Alignment { get; set; } = "";
        public string Deity { get; set; } = "";
        public string Appearance { get; set; } = "";
        public string Personality { get; set; } = "";
        public string Backstory { get; set; } = "";
    }
}
@page "/CharacterCreation"

<div class="bg-gray-900 text-gray-100 min-h-screen font-sans">

    <div class="flex h-[calc(100vh-80px)]">

        <!-- Sidebar -->
        <aside class="@(sidebarOpen ? "w-64" : "w-0 overflow-hidden") bg-gray-800 border-r border-gray-700 p-6 transition-all duration-300">
            @if (sidebarOpen)
            {
                <div>
                    <h3 class="text-xl font-semibold text-amber-400 mb-4">Character Info</h3>
                    <div class="space-y-4">
                        <input type="text" placeholder="Name" class="w-full p-2 rounded bg-gray-700 border border-gray-600" @bind="character.Name" />
                        <input type="text" placeholder="Ancestry" class="w-full p-2 rounded bg-gray-700 border border-gray-600" @bind="character.Ancestry" />
                        <input type="text" placeholder="Background" class="w-full p-2 rounded bg-gray-700 border border-gray-600" @bind="character.Background" />
                        <input type="text" placeholder="Class" class="w-full p-2 rounded bg-gray-700 border border-gray-600" @bind="character.Class" />
                    </div>
                </div>
            }
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col">

            <!-- Top Bar -->
            <div class="bg-gray-700 p-4 flex justify-between items-center border-b border-gray-600">
                <p class="text-lg">Size | Speed | Level | Attributes</p>
                <button @onclick="ToggleSidebar" class="bg-amber-500 text-gray-900 px-4 py-2 rounded">
                    Toggle Sidebar
                </button>
            </div>

            <!-- Tabs -->
            <div class="bg-gray-800 border-b border-gray-700 flex justify-center space-x-6 py-3">
                @foreach (var tab in tabs)
                {
                    <button class="@(activeTab == tab ? "text-amber-400 font-semibold" : "hover:text-amber-400")"
                            @onclick="() => SetTab(tab)">
                        @tab
                    </button>
                }
            </div>

            <!-- Content -->
            <div class="flex-1 p-8 bg-gray-800 overflow-y-auto">

                @if (activeTab == "Feats")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Feats</h2>
                    <p>Select feats for your character.</p>
                }
                else if (activeTab == "Weapons")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Weapons</h2>
                    <p>Choose your weapons.</p>
                }
                else if (activeTab == "Defense")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Defense</h2>
                    <p>Armor class and resistances.</p>
                }
                else if (activeTab == "Gear")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Gear</h2>
                    <p>Manage inventory.</p>
                }
                else if (activeTab == "Spells")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Spells</h2>
                    <p>Manage spells.</p>
                }
                else if (activeTab == "Actions")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Actions</h2>
                    <p>View available actions.</p>
                }
                else if (activeTab == "Other")
                {
                    <h2 class="text-2xl text-amber-400 mb-4">Other</h2>
                    <p>Other character details.</p>
                }

            </div>

        </main>

    </div>

</div>

@code {
    string activeTab = "Feats";
    bool sidebarOpen = true;

    string[] tabs = new[] { "Feats", "Weapons", "Defense", "Gear", "Spells", "Actions", "Other" };

    Character character = new();

    void SetTab(string tab)
    {
        activeTab = tab;
    }

    void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    public class Character
    {
        public string Name { get; set; } = "";
        public string Ancestry { get; set; } = "";
        public string Background { get; set; } = "";
        public string Class { get; set; } = "";
    }
}

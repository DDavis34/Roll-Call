@page "/CharacterSheet"

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Character Sheet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #e8dcc8; }
        ::-webkit-scrollbar-thumb { background: #a89070; border-radius: 3px; }
    }
    </style>
</head>

<body class="bg-[#f0ebe0] text-[#3a2a1a] min-h-screen">
    <div class="min-h-screen bg-[#f0ebe0] font-['Crimson_Text',_Georgia,_serif] text-[#3a2a1a]">

        <!-- Top Bar -->
        <div class="bg-[#c8b89a] border-b border-[#a89070] px-3 py-2 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-[#5a3e28]">Level</span>
                <span class="text-sm font-bold bg-white border border-[#a89070] rounded px-2 py-0.5">@character.Level</span>
                <span class="text-sm font-semibold text-[#5a3e28]">XP</span>
                <span class="text-sm font-bold bg-white border border-[#a89070] rounded px-2 py-0.5">@character.XP</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-sm text-[#5a3e28]">Name</span>
                <input type="text" @bind="character.Name" placeholder="Name"
                    class="text-sm bg-white border border-[#a89070] rounded px-2 py-0.5 w-36 focus:outline-none focus:border-[#8b1a1a]" />
            </div>
            <div class="flex items-center gap-4 text-sm text-[#5a3e28]">
                <span>SIZE <strong>@character.Size</strong></span>
                <span>SPEED <strong>@character.Speed</strong></span>
                <span>HP <strong>@character.HP/@character.MaxHP</strong></span>
                <span>HP Shield</span>
            </div>
        </div>

        <!-- Stats Header -->
        <div class="bg-[#ede0cc] border-b border-[#c8b49a] p-3">
            <div class="flex flex-wrap items-start gap-4">

                <!-- AC Shield -->
                <div class="flex flex-col items-center">
                    <div class="relative w-16 h-20">
                        <svg viewBox="0 0 64 80" class="w-full h-full">
                            <path d="M32 4 L60 16 L60 44 Q60 64 32 76 Q4 64 4 44 L4 16 Z"
                                fill="#8b1a1a" stroke="#6a0a0a" stroke-width="2" />
                            <path d="M32 10 L54 20 L54 44 Q54 60 32 70 Q10 60 10 44 L10 20 Z"
                                fill="#a02020" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
                            <span class="text-[10px] font-bold">AC</span>
                            <span class="text-2xl font-bold leading-none">@character.AC</span>
                        </div>
                    </div>
                </div>

                <!-- Ability Scores -->
                <div class="flex gap-3 flex-wrap">
                    @foreach (var ability in character.Abilities)
                    {
                        <div class="flex flex-col items-center">
                            <span class="text-xs font-bold text-[#8b1a1a] uppercase">@ability.Abbreviation</span>
                            <span class="text-xl font-bold">@ability.Score</span>
                            <span class="text-sm text-[#5a3e28]">@(ability.Modifier >= 0 ? "+" : "")@ability.Modifier</span>
                        </div>
                    }
                </div>

                <!-- Saves & HP -->
                <div class="flex flex-col gap-2">
                    <div class="flex gap-4">
                        @foreach (var save in character.Saves)
                        {
                            <div class="flex flex-col items-center">
                                <div class="w-5 h-5 rounded-full bg-[#8b1a1a] mb-1"></div>
                                <span class="text-sm font-bold">+@save.Modifier</span>
                                <span class="text-xs text-[#5a3e28]">@save.Name</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-2">
                    <button class="bg-white border border-[#a89070] hover:bg-[#ede0cc] text-[#5a3e28] text-xs font-semibold px-3 py-1 rounded transition-colors">Rest</button>
                    <button class="bg-white border border-[#a89070] hover:bg-[#ede0cc] text-[#5a3e28] text-xs font-semibold px-3 py-1 rounded transition-colors">Add Condition</button>
                    <button class="bg-white border border-[#a89070] hover:bg-[#ede0cc] text-[#5a3e28] text-xs font-semibold px-3 py-1 rounded transition-colors">Add Custom Buff</button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex flex-col lg:flex-row">

            <!-- LEFT SIDEBAR -->
            <div class="w-full lg:w-48 xl:w-52 bg-[#e8dcc8] border-b lg:border-b-0 lg:border-r border-[#c8b49a] p-3 flex-shrink-0 overflow-y-auto" style="max-height: calc(100vh - 150px);">
                <!-- Ancestry -->
                <div class="mb-2">
                    <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm hover:bg-[#f5efe3] transition-colors">
                        <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide">Ancestry</div>
                        <div class="font-semibold">@character.Ancestry</div>
                    </button>
                </div>

                <!-- Background -->
                <div class="mb-2">
                    <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm hover:bg-[#f5efe3] transition-colors">
                        <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide">Background</div>
                        <div class="font-semibold">@character.Background</div>
                    </button>
                </div>

                <!-- Class -->
                <div class="mb-3">
                    <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm hover:bg-[#f5efe3] transition-colors">
                        <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide flex items-center gap-1">
                            <span class="text-[#8b1a1a]">⚔</span> Class
                        </div>
                        <div class="font-semibold">@character.Class</div>
                    </button>
                </div>

                <!-- Level 1 -->
                <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide mb-1">Level 1</div>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-1 hover:bg-[#f5efe3] transition-colors flex items-center gap-2">
                    <span class="text-[#5a8a5a]">⚙</span>
                    <span>Set Abilities</span>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-1 hover:bg-[#f5efe3] transition-colors flex items-center gap-2">
                    <span class="text-[#5a8a5a]">⚙</span>
                    <span>Skill Training</span>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-2 hover:bg-[#f5efe3] transition-colors flex items-center gap-2">
                    <span class="text-[#5a8a5a]">⚙</span>
                    <span>Class Skill</span>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-1 hover:bg-[#f5efe3] transition-colors">
                    <div class="text-[#8b1a1a] text-xs flex items-center gap-1"><span>👤</span> Heritage</div>
                    <div class="text-gray-500 text-xs">Not Selected</div>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-1 hover:bg-[#f5efe3] transition-colors">
                    <div class="text-[#8b1a1a] text-xs flex items-center gap-1"><span>👤</span> Ancestry Feat</div>
                    <div class="text-gray-500 text-xs">Not Selected</div>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-2 hover:bg-[#f5efe3] transition-colors">
                    <div class="text-[#8b1a1a] text-xs flex items-center gap-1"><span>⚔</span> Class Feat</div>
                    <div class="text-gray-500 text-xs">Not Selected</div>
                </button>

                <div class="text-xs text-[#5a3e28] mb-1">Reactive Strike →</div>
                <div class="text-xs text-[#5a3e28] mb-1">Free Feat: Shield Block →</div>
                <div class="text-xs text-[#5a3e28] mb-3">Free Feat: Hobnobber</div>

                <!-- Level 2 -->
                <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide mb-1">Level 2</div>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-1 hover:bg-[#f5efe3] transition-colors">
                    <div class="text-[#8b1a1a] text-xs flex items-center gap-1"><span>⚔</span> Class Feat</div>
                    <div class="text-gray-500 text-xs">Not Selected</div>
                </button>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm mb-3 hover:bg-[#f5efe3] transition-colors">
                    <div class="text-[#8b1a1a] text-xs flex items-center gap-1"><span>⚙</span> Skill Feat</div>
                    <div class="text-gray-500 text-xs">Not Selected</div>
                </button>

                <!-- Level 3 -->
                <div class="text-[#8b1a1a] text-xs font-bold uppercase tracking-wide mb-1">Level 3</div>

                <button class="w-full text-left bg-white border border-[#c8b49a] rounded px-2 py-1.5 text-sm hover:bg-[#f5efe3] transition-colors flex items-center justify-center gap-2">
                    <span class="text-[#5a8a5a]">⚙</span>
                    <span>Skill Increase</span>
                </button>
            </div>

            <!-- MIDDLE: Stats Panel -->
            <div class="w-full lg:w-52 xl:w-56 bg-[#e8dcc8] border-b lg:border-b-0 lg:border-r border-[#c8b49a] p-3 flex-shrink-0 overflow-y-auto" style="max-height: calc(100vh - 150px);">

                <!-- Hero Points -->
                <div class="flex items-center gap-2 mb-3">
                    <div class="w-7 h-7 rounded-full bg-[#8b1a1a] flex items-center justify-center text-white text-sm font-bold">@character.HeroPoints</div>
                    <span class="text-sm font-semibold">Hero Points</span>
                    <div class="flex gap-1 ml-1">
                        <div class="w-4 h-4 rounded-full border-2 border-[#8b1a1a]"></div>
                        <div class="w-4 h-4 rounded-full border-2 border-[#8b1a1a]"></div>
                        <div class="w-4 h-4 rounded-full border-2 border-[#8b1a1a]"></div>
                    </div>
                </div>

                <!-- Fighter DC -->
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-7 h-7 rounded-full bg-[#9a9a9a] flex items-center justify-center text-white text-xs font-bold">⚔</div>
                    <span class="text-sm font-semibold">+@character.FighterDC Fighter DC</span>
                </div>

                <!-- Perception -->
                <div class="flex items-center gap-2 mb-2">
                    <div class="w-6 h-6 rounded-full bg-[#c8a87a] border-2 border-[#8b6a3a] flex items-center justify-center text-[10px] font-bold text-[#3a2a1a]">👁</div>
                    <span class="text-sm">+@character.Perception Perception</span>
                </div>

                <!-- Initiative -->
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-6 h-6 rounded-full bg-[#c8d8b8] border-2 border-[#7a9a6a] flex items-center justify-center text-[10px] font-bold text-[#3a2a1a]">⚡</div>
                    <span class="text-sm">+@character.Initiative Initiative</span>
                </div>

                <!-- Skills -->
                @foreach (var skill in character.Skills)
                {
                    <div class="flex items-center gap-2 mb-1">
                        <div class="w-5 h-5 rounded-full @(skill.Trained ? "bg-[#3a2a1a]" : "border-2 border-[#9a8a7a]") flex-shrink-0">
                            @if (skill.Trained)
                            {
                                <div class="w-full h-full rounded-full flex items-center justify-center">
                                    <span class="text-white text-[9px] font-bold">@skill.ProficiencyLetter</span>
                                </div>
                            }
                            else
                            {
                                <div class="w-full h-full rounded-full bg-[#e8dcc8] flex items-center justify-center">
                                    <span class="text-[#9a8a7a] text-[9px] font-bold">@skill.ProficiencyLetter</span>
                                </div>
                            }
                        </div>
                        <span class="text-xs w-7 text-right font-semibold @(skill.Modifier >= 0 ? "text-[#3a2a1a]" : "text-red-700")">
                            @(skill.Modifier >= 0 ? "+" : "")@skill.Modifier
                        </span>
                        <span class="text-xs text-[#5a3e28]">@skill.Name</span>
                    </div>
                }
            </div>

            <!-- RIGHT: Main Character Panel -->
            <div class="flex-1 flex flex-col min-w-0">

            <!-- Tab Buttons -->
            <div class="bg-[#e8dcc8] border-b border-[#c8b49a] flex flex-wrap">
                @foreach (var tab in tabs)
                {
                    <button @onclick="() => SetActiveTab(tab)" class="@TabClass(tab)">
                        @tab
                    </button>
                }
            </div>

            <!-- Tab Content -->
            <div class="flex-1 p-4 bg-[#f5efe3] overflow-y-auto" style="max-height: calc(100vh - 190px);">

                <!-- ─── WEAPONS ─────────────────────────────────────────── -->
                @if (activeTab == "Weapons")
                {
                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach (var cat in weaponCategories)
                        {
                            <button @onclick="() => ToggleWeaponCategory(cat.Key)"
                                    class="px-3 py-1.5 text-sm font-semibold rounded transition-colors flex items-center gap-1
                                           @(cat.Value ? "bg-[#8b1a1a] border-2 border-[#8b1a1a] text-white" : "bg-[#e8dcc8] border-2 border-[#c8b49a] text-[#5a3e28] hover:border-[#8b1a1a]")">
                                <span>@(cat.Value ? "●" : "○")</span> @cat.Key
                            </button>
                        }
                    </div>

                    <button @onclick="() => showWeaponModal = true"
                            class="w-full border-2 border-dashed border-[#c8b49a] hover:border-[#8b1a1a] text-[#8b1a1a] font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-[#faf5ee]">
                        + Add Weapon
                    </button>

                    @if (!weapons.Any())
                    {
                        <div class="text-center text-[#9a8a7a] text-sm py-8">No weapons equipped. Click "Add Weapon" to equip weapons.</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var (weapon, index) in weapons.Select((w, i) => (w, i)))
                            {
                                <div class="bg-white border border-[#c8b49a] rounded p-3 flex flex-wrap items-center gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="font-bold text-sm">@weapon.Name</div>
                                        <div class="text-xs text-[#5a3e28]">@weapon.Traits</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold">@(weapon.AttackBonus >= 0 ? "+" : "")@weapon.AttackBonus</div>
                                        <div class="text-xs text-[#5a3e28]">Attack</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold">@weapon.Damage</div>
                                        <div class="text-xs text-[#5a3e28]">Damage</div>
                                    </div>
                                    <button @onclick="() => weapons.RemoveAt(index)" class="text-red-700 hover:text-red-900 text-sm px-2">✕</button>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-4 text-right">
                        <button class="text-sm text-[#5a3e28] hover:text-[#8b1a1a] underline">Print</button>
                    </div>
                }

                else if (activeTab == "Defense")
                {
                    <!-- ─── DEFENSE ─────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Defense</h3>

                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach (var cat in armorCategories)
                        {
                            <button @onclick="() => ToggleArmorCategory(cat.Key)"
                                    class="px-3 py-1.5 text-sm font-semibold rounded transition-colors
                                           @(cat.Value ? "bg-[#8b1a1a] border-2 border-[#8b1a1a] text-white" : "bg-[#e8dcc8] border-2 border-[#c8b49a] text-[#5a3e28] hover:border-[#8b1a1a]")">
                                @cat.Key
                            </button>
                        }
                    </div>

                    <button @onclick="() => showArmorModal = true"
                            class="w-full border-2 border-dashed border-[#c8b49a] hover:border-[#8b1a1a] text-[#8b1a1a] font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-[#faf5ee]">
                        + Add Armor / Shield
                    </button>

                    @if (!armors.Any())
                    {
                        <div class="text-center text-[#9a8a7a] text-sm py-8">No armor equipped. Click "Add Armor / Shield" to equip.</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var (armor, index) in armors.Select((a, i) => (a, i)))
                            {
                                <div class="bg-white border border-[#c8b49a] rounded p-3 flex items-center gap-3">
                                    <div class="flex-1">
                                        <div class="font-bold text-sm">@armor.Name</div>
                                        <div class="text-xs text-[#5a3e28]">@armor.Category</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold">+@armor.ACBonus</div>
                                        <div class="text-xs text-[#5a3e28]">AC Bonus</div>
                                    </div>
                                    <button @onclick="() => armors.RemoveAt(index)" class="text-red-700 hover:text-red-900 text-sm px-2">✕</button>
                                </div>
                            }
                        </div>
                    }
                }

                else if (activeTab == "Gear")
                {
                    <!-- ─── GEAR ────────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Gear & Equipment</h3>

                    <button @onclick="() => showGearModal = true"
                            class="w-full border-2 border-dashed border-[#c8b49a] hover:border-[#8b1a1a] text-[#8b1a1a] font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-[#faf5ee]">
                        + Add Item
                    </button>

                    @if (!gearItems.Any())
                    {
                        <div class="text-center text-[#9a8a7a] text-sm py-8">No items in inventory.</div>
                    }
                    else
                    {
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-[#c8b49a] text-[#8b1a1a] text-left">
                                    <th class="pb-2 font-semibold">Item</th>
                                    <th class="pb-2 font-semibold text-center">Qty</th>
                                    <th class="pb-2 font-semibold text-center">Bulk</th>
                                    <th class="pb-2"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (item, index) in gearItems.Select((g, i) => (g, i)))
                                {
                                    <tr class="border-b border-[#e8dcc8] hover:bg-[#faf5ee]">
                                        <td class="py-2 font-medium">@item.Name</td>
                                        <td class="py-2 text-center">@item.Quantity</td>
                                        <td class="py-2 text-center">@item.Weight</td>
                                        <td class="py-2 text-right">
                                            <button @onclick="() => gearItems.RemoveAt(index)" class="text-red-700 hover:text-red-900">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="mt-3 text-sm text-right text-[#5a3e28]">
                            Total Bulk: <strong>@gearItems.Sum(i => i.Weight * i.Quantity)</strong>
                        </div>
                    }
                }

                else if (activeTab == "Spells")
                {
                    <!-- ─── SPELLS ───────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Spells</h3>

                    @if (!spells.Any())
                    {
                        <div class="text-center text-[#9a8a7a] text-sm py-8">
                            <div class="text-4xl mb-3">✦</div>
                            <div>No spells prepared. This character has no spellcasting ability, or no spells have been added yet.</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var levelGroup in spells.GroupBy(s => s.Level).OrderBy(g => g.Key))
                        {
                            <div class="mb-4">
                                <div class="text-sm font-bold text-[#8b1a1a] mb-2 border-b border-[#c8b49a] pb-1">
                                    @(levelGroup.Key == 0 ? "Cantrips" : $"Level {levelGroup.Key} Spells")
                                </div>
                                @foreach (var spell in levelGroup)
                                {
                                    <div class="bg-white border border-[#c8b49a] rounded p-3 mb-2">
                                        <div class="flex justify-between items-start">
                                            <div>
                                                <div class="font-bold text-sm">@spell.Name</div>
                                                <div class="text-xs text-[#5a3e28]">@spell.School • @spell.CastTime</div>
                                            </div>
                                            <button @onclick="() => spells.Remove(spell)" class="text-red-700 hover:text-red-900 text-sm">✕</button>
                                        </div>
                                        <div class="text-xs text-[#5a3e28] mt-1">@spell.Description</div>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <button @onclick="() => showSpellModal = true"
                            class="w-full border-2 border-dashed border-[#c8b49a] hover:border-[#8b1a1a] text-[#8b1a1a] font-semibold py-2 px-4 rounded text-left mt-2 transition-colors hover:bg-[#faf5ee]">
                        + Add Spell
                    </button>
                }

                else if (activeTab == "Pets")
                {
                    <!-- ─── PETS ─────────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Animal Companions & Familiars</h3>
                    <div class="text-center text-[#9a8a7a] text-sm py-8">
                        <div class="text-4xl mb-3">🐾</div>
                        <div>No animal companions or familiars. Add a class feature that grants a pet to track it here.</div>
                    </div>
                }

                else if (activeTab == "Details")
                {
                    <!-- ─── DETAILS ──────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Character Details</h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Age</label>
                            <input @bind="details.Age" placeholder="e.g., 25"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Gender & Pronouns</label>
                            <input @bind="details.Gender" placeholder="e.g., Male, he/him"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Height</label>
                            <input @bind="details.Height" placeholder="e.g., 6'1&quot;"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Weight</label>
                            <input @bind="details.Weight" placeholder="e.g., 180 lbs"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Alignment</label>
                            <select @bind="details.Alignment"
                                    class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white">
                                <option value="">— Select —</option>
                                <option>Lawful Good</option><option>Neutral Good</option><option>Chaotic Good</option>
                                <option>Lawful Neutral</option><option>True Neutral</option><option>Chaotic Neutral</option>
                                <option>Lawful Evil</option><option>Neutral Evil</option><option>Chaotic Evil</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-sm font-semibold text-[#5a3e28]">Deity</label>
                            <input @bind="details.Deity" placeholder="e.g., Cayden Cailean"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-sm font-semibold text-[#5a3e28]">Appearance</label>
                        <textarea @bind="details.Appearance" rows="3" placeholder="Describe your character's physical appearance..."
                                  class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white resize-none"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="text-sm font-semibold text-[#5a3e28]">Personality</label>
                        <textarea @bind="details.Personality" rows="3" placeholder="Describe your character's personality..."
                                  class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white resize-none"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="text-sm font-semibold text-[#5a3e28]">Backstory</label>
                        <textarea @bind="details.Backstory" rows="5" placeholder="Write your character's backstory..."
                                  class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white resize-none"></textarea>
                    </div>

                    <h4 class="text-sm font-bold text-[#8b1a1a] mb-2">Currency</h4>
                    <div class="flex flex-wrap gap-4">
                        @foreach (var coin in currencies)
                        {
                            <div class="flex flex-col items-center">
                                <div class="w-8 h-8 rounded-full @coin.Color flex items-center justify-center text-white text-xs font-bold shadow">@coin.Abbr</div>
                                <input @bind="coin.Amount" type="number" min="0"
                                       class="w-16 mt-1 border border-[#c8b49a] rounded px-1 py-0.5 text-sm text-center focus:outline-none focus:border-[#8b1a1a] bg-white" />
                                <span class="text-xs text-[#5a3e28] mt-0.5">@coin.Name</span>
                            </div>
                        }
                    </div>
                }

                else if (activeTab == "Feats")
                {
                    <!-- ─── FEATS ─────────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Feats & Abilities</h3>

                    @foreach (var category in featsByCategory.Keys)
                    {
                        <div class="mb-4">
                            <div class="flex items-center justify-between border-b border-[#c8b49a] pb-1 mb-2">
                                <h4 class="text-sm font-bold text-[#5a3e28]">@category</h4>
                                <button @onclick="() => OpenFeatModal(category)"
                                        class="text-xs text-[#8b1a1a] hover:text-[#6a0a0a] font-semibold">+ Add</button>
                            </div>
                            @if (!featsByCategory[category].Any())
                            {
                                <div class="text-xs text-[#9a8a7a] italic px-2">No @category.ToLower() added.</div>
                            }
                            else
                            {
                                @foreach (var feat in featsByCategory[category])
                                {
                                    <div class="bg-white border border-[#c8b49a] rounded p-2 mb-1 flex items-start justify-between gap-2">
                                        <div>
                                            <div class="text-sm font-semibold">@feat.Name</div>
                                            @if (!string.IsNullOrEmpty(feat.Description))
                                            {
                                                <div class="text-xs text-[#5a3e28] mt-0.5">@feat.Description</div>
                                            }
                                        </div>
                                        <button @onclick="() => featsByCategory[category].Remove(feat)"
                                                class="text-red-700 hover:text-red-900 text-xs flex-shrink-0">✕</button>
                                    </div>
                                }
                            }
                        </div>
                    }
                }

                else if (activeTab == "Actions")
                {
                    <!-- ─── ACTIONS ───────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-[#8b1a1a] mb-3">Actions & Activities</h3>

                    @foreach (var section in actionSections)
                    {
                        <div class="mb-5">
                            <div class="text-sm font-bold text-[#5a3e28] border-b border-[#c8b49a] pb-1 mb-2"></div>
                            <div class="space-y-2">
                                @foreach (var action in section.Actions)
                                {
                                    <div class="bg-white border border-[#c8b49a] rounded p-3">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-sm font-bold">@action.Name</span>
                                            <span class="text-xs bg-[#8b1a1a] text-white rounded-full px-2 py-0.5">@action.ActionCost</span>
                                            @if (!string.IsNullOrEmpty(action.Traits))
                                            {
                                                <span class="text-xs text-[#5a3e28] italic">@action.Traits</span>
                                            }
                                        </div>
                                        <p class="text-xs text-[#5a3e28]">@action.Description</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

            </div><!-- end tab content -->
        </div><!-- end right panel -->
    </div><!-- end flex row -->

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MODALS                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    @if (showWeaponModal)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="() => showWeaponModal = false">
            <div class="bg-[#f5efe3] border border-[#c8b49a] rounded-lg p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
                <h3 class="text-lg font-bold mb-4 text-[#8b1a1a]">Add Weapon</h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Weapon Name</label>
                        <input @bind="newWeapon.Name" placeholder="e.g., Longsword"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Damage</label>
                        <input @bind="newWeapon.Damage" placeholder="e.g., 1d8+3 S"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Attack Bonus</label>
                        <input @bind="newWeapon.AttackBonus" type="number"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Traits</label>
                        <input @bind="newWeapon.Traits" placeholder="e.g., versatile P, sweep"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <button @onclick="ConfirmAddWeapon" class="flex-1 bg-[#8b1a1a] hover:bg-[#6a0a0a] text-white font-semibold py-2 rounded transition-colors">Add</button>
                    <button @onclick="() => showWeaponModal = false" class="flex-1 bg-[#e8dcc8] hover:bg-[#d8ccb8] text-[#5a3e28] font-semibold py-2 rounded transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (showArmorModal)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="() => showArmorModal = false">
            <div class="bg-[#f5efe3] border border-[#c8b49a] rounded-lg p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
                <h3 class="text-lg font-bold mb-4 text-[#8b1a1a]">Add Armor / Shield</h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Name</label>
                        <input @bind="newArmor.Name" placeholder="e.g., Chain Mail"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Category</label>
                        <select @bind="newArmor.Category"
                                class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white">
                            <option>Light Armor</option>
                            <option>Medium Armor</option>
                            <option>Heavy Armor</option>
                            <option>Shield</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">AC Bonus</label>
                        <input @bind="newArmor.ACBonus" type="number"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <button @onclick="ConfirmAddArmor" class="flex-1 bg-[#8b1a1a] hover:bg-[#6a0a0a] text-white font-semibold py-2 rounded transition-colors">Add</button>
                    <button @onclick="() => showArmorModal = false" class="flex-1 bg-[#e8dcc8] hover:bg-[#d8ccb8] text-[#5a3e28] font-semibold py-2 rounded transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (showGearModal)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="() => showGearModal = false">
            <div class="bg-[#f5efe3] border border-[#c8b49a] rounded-lg p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
                <h3 class="text-lg font-bold mb-4 text-[#8b1a1a]">Add Item</h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Item Name</label>
                        <input @bind="newGear.Name" placeholder="e.g., Healing Potion"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div class="flex gap-3">
                        <div class="flex-1">
                            <label class="text-sm font-semibold text-[#5a3e28]">Quantity</label>
                            <input @bind="newGear.Quantity" type="number" min="1"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div class="flex-1">
                            <label class="text-sm font-semibold text-[#5a3e28]">Bulk</label>
                            <input @bind="newGear.Weight" type="number" step="0.1" min="0"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <button @onclick="ConfirmAddGear" class="flex-1 bg-[#8b1a1a] hover:bg-[#6a0a0a] text-white font-semibold py-2 rounded transition-colors">Add</button>
                    <button @onclick="() => showGearModal = false" class="flex-1 bg-[#e8dcc8] hover:bg-[#d8ccb8] text-[#5a3e28] font-semibold py-2 rounded transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (showSpellModal)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="() => showSpellModal = false">
            <div class="bg-[#f5efe3] border border-[#c8b49a] rounded-lg p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
                <h3 class="text-lg font-bold mb-4 text-[#8b1a1a]">Add Spell</h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Spell Name</label>
                        <input @bind="newSpell.Name" placeholder="e.g., Fireball"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div class="flex gap-3">
                        <div class="flex-1">
                            <label class="text-sm font-semibold text-[#5a3e28]">Level</label>
                            <input @bind="newSpell.Level" type="number" min="0" max="10"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                        <div class="flex-1">
                            <label class="text-sm font-semibold text-[#5a3e28]">School</label>
                            <input @bind="newSpell.School" placeholder="e.g., Evocation"
                                   class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                        </div>
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Cast Time</label>
                        <input @bind="newSpell.CastTime" placeholder="e.g., 2 Actions"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Description</label>
                        <textarea @bind="newSpell.Description" rows="3" placeholder="Spell description..."
                                  class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white resize-none"></textarea>
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <button @onclick="ConfirmAddSpell" class="flex-1 bg-[#8b1a1a] hover:bg-[#6a0a0a] text-white font-semibold py-2 rounded transition-colors">Add</button>
                    <button @onclick="() => showSpellModal = false" class="flex-1 bg-[#e8dcc8] hover:bg-[#d8ccb8] text-[#5a3e28] font-semibold py-2 rounded transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (showFeatModal)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="() => showFeatModal = false">
            <div class="bg-[#f5efe3] border border-[#c8b49a] rounded-lg p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
                <h3 class="text-lg font-bold mb-4 text-[#8b1a1a]">Add @currentFeatCategory Feat</h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Feat Name</label>
                        <input @bind="newFeat.Name" placeholder="e.g., Power Attack"
                               class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-[#5a3e28]">Description (optional)</label>
                        <textarea @bind="newFeat.Description" rows="3" placeholder="Feat description..."
                                  class="w-full mt-1 border border-[#c8b49a] rounded px-3 py-1.5 text-sm focus:outline-none focus:border-[#8b1a1a] bg-white resize-none"></textarea>
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <button @onclick="ConfirmAddFeat" class="flex-1 bg-[#8b1a1a] hover:bg-[#6a0a0a] text-white font-semibold py-2 rounded transition-colors">Add</button>
                    <button @onclick="() => showFeatModal = false" class="flex-1 bg-[#e8dcc8] hover:bg-[#d8ccb8] text-[#5a3e28] font-semibold py-2 rounded transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    }
    </div>
</body>


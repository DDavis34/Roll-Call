@page "/create-character/{CharacterId:guid?}"
@using System.Text.Json
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using PF2EGM.Services
@using PF2EGM.Components.Widgets

@inject IApiCharacterService CharacterService
@inject NavigationManager Nav
@inject SupabaseSessionStore SessionStore
@inject IJSRuntime JS

@implements IAsyncDisposable

<PageTitle>Character Sheet</PageTitle>

<div class="bg-gray-900 text-gray-100 min-h-screen" style="font-family: Georgia, serif;">

    <!-- Fixed top toolbar (always visible, not a widget) -->
    <div class="bg-gray-900 border-b border-gray-700/60 px-4 py-2 flex items-center justify-between flex-wrap gap-2 sticky top-0 z-30">
        <div class="flex items-center gap-2">
            <span class="text-sm font-semibold text-gray-300">Level</span>
            <span class="text-sm font-bold bg-gray-800 border border-gray-600 rounded px-2 py-0.5 text-amber-400">@character.Level</span>
            <span class="text-sm font-semibold text-gray-300">XP</span>
            <span class="text-sm font-bold bg-gray-800 border border-gray-600 rounded px-2 py-0.5 text-gray-100">@character.XP</span>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-sm text-gray-300">Name</span>
            <input type="text" @bind="character.Name" placeholder="Name"
                class="text-sm bg-gray-800 border border-gray-600 rounded px-2 py-0.5 w-36 focus:outline-none focus:border-amber-500 text-gray-100 placeholder-gray-400" />
        </div>
        <div class="flex items-center gap-4 text-sm text-gray-300">
            <span>SIZE <strong class="text-gray-100">@character.Size</strong></span>
            <span>SPEED <strong class="text-gray-100">@character.Speed</strong></span>
            <span>HP <strong class="text-amber-400">@character.HP/@character.MaxHP</strong></span>
            <span>HP Shield</span>
        </div>
        <div class="flex items-center gap-2">
            <LumexButton OnClick="SaveCharacterAsync" Color="@ThemeColor.Primary" Disabled="@isSaving" Size="@Size.Small">
                @(isSaving ? "Saving…" : characterId.HasValue ? "Save Changes" : "Save Character")
            </LumexButton>
            @if (!SessionStore.IsAuthenticated)
            {
                <LumexButton Variant="@Variant.Outlined" Size="@Size.Small" OnClick="@(() => Nav.NavigateTo("/login"))">
                    Log in to save
                </LumexButton>
            }
            <LumexButton Variant="@Variant.Flat" Size="@Size.Small" OnClick="ToggleWidgetMode">
                @(widgetMode ? "⊞ Lock Layout" : "⊞ Widget Mode")
            </LumexButton>
            @if (widgetMode)
            {
                <LumexButton Variant="@Variant.Flat" Size="@Size.Small" OnClick="@(() => showCustomizePanel = !showCustomizePanel)">
                    ⚙ Customize
                </LumexButton>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(saveStatusMessage))
    {
        <div class="mx-3 my-3 rounded-xl border px-4 py-3 text-sm @(saveStatusIsError ? "border-red-800 bg-red-950/40 text-red-200" : "border-emerald-800 bg-emerald-950/30 text-emerald-200")">
            @saveStatusMessage
        </div>
    }

    <!-- Content area: normal layout or widget canvas -->
    <div class="@(widgetMode ? "relative overflow-x-hidden" : "")" id="@(widgetMode ? "widget-canvas" : "")" style="@(widgetMode ? "min-height: calc(100vh - 52px);" : "")">

    @if (widgetMode)
    {
        <!-- Widget mode: floating customize panel -->
        @if (showCustomizePanel)
        {
            <div class="fixed right-4 top-16 z-50 w-64 bg-gray-800 border border-gray-700/60 rounded-2xl shadow-2xl overflow-hidden">
                <div class="px-4 py-3 bg-gray-900/70 border-b border-gray-700/60 flex items-center justify-between">
                    <div>
                        <div class="text-xs font-bold text-amber-400 uppercase tracking-widest">Widget Visibility</div>
                        <div class="text-[11px] text-gray-500 mt-0.5">Toggle panels on or off</div>
                    </div>
                    <button @onclick="@(() => showCustomizePanel = false)"
                            class="w-6 h-6 rounded-md flex items-center justify-center text-gray-500 hover:text-red-400 hover:bg-gray-700/60 transition-colors text-xs">
                        ✕
                    </button>
                </div>
                <div class="p-4 space-y-3">
                    @foreach (var ws in widgetStates)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-300">@widgetLabels[ws.Key]</span>
                            <button @onclick="() => ToggleWidgetVisible(ws.Key)"
                                    class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors @(ws.Value.Visible ? "bg-amber-500" : "bg-gray-600")">
                                <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow transition-transform @(ws.Value.Visible ? "translate-x-4" : "translate-x-1")"></span>
                            </button>
                        </div>
                    }
                    <div class="pt-2 border-t border-gray-700/60">
                        <LumexButton Variant="@Variant.Flat" Size="@Size.Small" Class="w-full" OnClick="ResetWidgetPositions">
                            Reset Positions
                        </LumexButton>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Stats Header -->
    <DraggableWidget WidgetId="combat-stats" Title="Combat Stats" Subtitle="AC · Abilities · Saves"
                     IsDragMode="@widgetMode" State="@widgetStates["combat-stats"]" OnHide="HideWidget"
                     MaxHeight="220">
    <div class="bg-gray-800 @(widgetMode ? "" : "border-b border-gray-700") p-3">
        <div class="flex flex-wrap items-start gap-4">

            <!-- AC Shield -->
            <div class="flex flex-col items-center">
                <div class="relative w-16 h-20">
                    <svg viewBox="0 0 64 80" class="w-full h-full">
                        <path d="M32 4 L60 16 L60 44 Q60 64 32 76 Q4 64 4 44 L4 16 Z"
                            fill="#d97706" stroke="#b45309" stroke-width="2" />
                        <path d="M32 10 L54 20 L54 44 Q54 60 32 70 Q10 60 10 44 L10 20 Z"
                            fill="#f59e0b" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-900">
                        <span class="text-[10px] font-bold">AC</span>
                        <span class="text-2xl font-bold leading-none">@character.AC</span>
                    </div>
                </div>
            </div>

            <!-- Ability Scores -->
            <div class="flex gap-3 flex-wrap">
                @foreach (var ability in character.Abilities)
                {
                    <div class="flex flex-col items-center">
                        <span class="text-xs font-bold text-amber-400 uppercase">@ability.Abbreviation</span>
                        <span class="text-xl font-bold text-gray-100">@ability.Score</span>
                        <span class="text-sm text-gray-300">@(ability.Modifier >= 0 ? "+" : "")@ability.Modifier</span>
                    </div>
                }
            </div>

            <!-- Saves -->
            <div class="flex flex-col gap-2">
                <div class="flex gap-4">
                    @foreach (var save in character.Saves)
                    {
                        <div class="flex flex-col items-center">
                            <div class="w-5 h-5 rounded-full bg-amber-600 mb-1"></div>
                            <span class="text-sm font-bold text-gray-100">+@save.Modifier</span>
                            <span class="text-xs text-gray-300">@save.Name</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-2">
                <LumexButton Size="@Size.Small" Variant="@Variant.Flat">Rest</LumexButton>
                <LumexButton Size="@Size.Small" Variant="@Variant.Flat">Add Condition</LumexButton>
                <LumexButton Size="@Size.Small" Variant="@Variant.Flat">Add Custom Buff</LumexButton>
            </div>
        </div>
    </div>
    </DraggableWidget>

    <!-- Main Content -->
    <div class="@(widgetMode ? "" : "flex flex-col lg:flex-row")">

        <!-- LEFT SIDEBAR -->
        <DraggableWidget WidgetId="background-leveling" Title="Background & Leveling" Subtitle="Ancestry · Class · Feats"
                         IsDragMode="@widgetMode" State="@widgetStates["background-leveling"]" OnHide="HideWidget"
                         MaxHeight="600">
        <div class="@(widgetMode ? "" : "w-full lg:w-48 xl:w-52") bg-gray-800 @(widgetMode ? "" : "border-b lg:border-b-0 lg:border-r border-gray-700") p-3 flex-shrink-0 overflow-y-auto" style="@(widgetMode ? "" : "max-height: calc(100vh - 150px)")">
            <!-- Ancestry -->
            <div class="mb-2">
                <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm hover:bg-gray-600 transition-colors">
                    <div class="text-amber-400 text-xs font-bold uppercase tracking-wide">Ancestry</div>
                    <div class="font-semibold text-gray-100">@character.Ancestry</div>
                </button>
            </div>

            <!-- Background -->
            <div class="mb-2">
                <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm hover:bg-gray-600 transition-colors">
                    <div class="text-amber-400 text-xs font-bold uppercase tracking-wide">Background</div>
                    <div class="font-semibold text-gray-100">@character.Background</div>
                </button>
            </div>

            <!-- Class -->
            <div class="mb-3">
                <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm hover:bg-gray-600 transition-colors">
                    <div class="text-amber-400 text-xs font-bold uppercase tracking-wide flex items-center gap-1">
                        <span>⚔</span> Class
                    </div>
                    <div class="font-semibold text-gray-100">@character.Class</div>
                </button>
            </div>

            <!-- Level 1 -->
            <div class="text-amber-400 text-xs font-bold uppercase tracking-wide mb-1">Level 1</div>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-1 hover:bg-gray-600 transition-colors flex items-center gap-2">
                <span class="text-green-400">⚙</span>
                <span class="text-gray-100">Set Abilities</span>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-1 hover:bg-gray-600 transition-colors flex items-center gap-2">
                <span class="text-green-400">⚙</span>
                <span class="text-gray-100">Skill Training</span>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-2 hover:bg-gray-600 transition-colors flex items-center gap-2">
                <span class="text-green-400">⚙</span>
                <span class="text-gray-100">Class Skill</span>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-1 hover:bg-gray-600 transition-colors">
                <div class="text-amber-400 text-xs flex items-center gap-1"><span>👤</span> Heritage</div>
                <div class="text-gray-400 text-xs">Not Selected</div>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-1 hover:bg-gray-600 transition-colors">
                <div class="text-amber-400 text-xs flex items-center gap-1"><span>👤</span> Ancestry Feat</div>
                <div class="text-gray-400 text-xs">Not Selected</div>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-2 hover:bg-gray-600 transition-colors">
                <div class="text-amber-400 text-xs flex items-center gap-1"><span>⚔</span> Class Feat</div>
                <div class="text-gray-400 text-xs">Not Selected</div>
            </button>

            <div class="text-xs text-gray-300 mb-1">Reactive Strike →</div>
            <div class="text-xs text-gray-300 mb-1">Free Feat: Shield Block →</div>
            <div class="text-xs text-gray-300 mb-3">Free Feat: Hobnobber</div>

            <!-- Level 2 -->
            <div class="text-amber-400 text-xs font-bold uppercase tracking-wide mb-1">Level 2</div>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-1 hover:bg-gray-600 transition-colors">
                <div class="text-amber-400 text-xs flex items-center gap-1"><span>⚔</span> Class Feat</div>
                <div class="text-gray-400 text-xs">Not Selected</div>
            </button>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm mb-3 hover:bg-gray-600 transition-colors">
                <div class="text-amber-400 text-xs flex items-center gap-1"><span>⚙</span> Skill Feat</div>
                <div class="text-gray-400 text-xs">Not Selected</div>
            </button>

            <!-- Level 3 -->
            <div class="text-amber-400 text-xs font-bold uppercase tracking-wide mb-1">Level 3</div>

            <button class="w-full text-left bg-gray-700 border border-gray-600 rounded px-2 py-1.5 text-sm hover:bg-gray-600 transition-colors flex items-center justify-center gap-2">
                <span class="text-green-400">⚙</span>
                <span class="text-gray-100">Skill Increase</span>
            </button>
        </div>
        </DraggableWidget>

        <!-- MIDDLE: Stats Panel -->
        <DraggableWidget WidgetId="skills-panel" Title="Skills & Stats" Subtitle="Perception · Initiative · Skills"
                         IsDragMode="@widgetMode" State="@widgetStates["skills-panel"]" OnHide="HideWidget"
                         MaxHeight="600">
        <div class="@(widgetMode ? "" : "w-full lg:w-52 xl:w-56") bg-gray-800 @(widgetMode ? "" : "border-b lg:border-b-0 lg:border-r border-gray-700") p-3 flex-shrink-0 overflow-y-auto" style="@(widgetMode ? "" : "max-height: calc(100vh - 150px)")">

            <!-- Hero Points -->
            <div class="flex items-center gap-2 mb-3">
                <div class="w-7 h-7 rounded-full bg-amber-600 flex items-center justify-center text-white text-sm font-bold">@character.HeroPoints</div>
                <span class="text-sm font-semibold text-gray-100">Hero Points</span>
                <div class="flex gap-1 ml-1">
                    <div class="w-4 h-4 rounded-full border-2 border-amber-500"></div>
                    <div class="w-4 h-4 rounded-full border-2 border-amber-500"></div>
                    <div class="w-4 h-4 rounded-full border-2 border-amber-500"></div>
                </div>
            </div>

            <!-- Fighter DC -->
            <div class="flex items-center gap-2 mb-4">
                <div class="w-7 h-7 rounded-full bg-gray-600 flex items-center justify-center text-white text-xs font-bold">⚔</div>
                <span class="text-sm font-semibold text-gray-100">+@character.FighterDC Fighter DC</span>
            </div>

            <!-- Perception -->
            <div class="flex items-center gap-2 mb-2">
                <div class="w-6 h-6 rounded-full bg-amber-600 border-2 border-amber-700 flex items-center justify-center text-[10px] font-bold text-white">👁</div>
                <span class="text-sm text-gray-100">+@character.Perception Perception</span>
            </div>

            <!-- Initiative -->
            <div class="flex items-center gap-2 mb-4">
                <div class="w-6 h-6 rounded-full bg-green-700 border-2 border-green-600 flex items-center justify-center text-[10px] font-bold text-white">⚡</div>
                <span class="text-sm text-gray-100">+@character.Initiative Initiative</span>
            </div>

            <!-- Skills -->
            @foreach (var skill in character.Skills)
            {
                <div class="flex items-center gap-2 mb-1">
                    <div class="w-5 h-5 rounded-full @(skill.Trained ? "bg-amber-600" : "border-2 border-gray-600 bg-gray-800") flex-shrink-0">
                        @if (skill.Trained)
                        {
                            <div class="w-full h-full rounded-full flex items-center justify-center">
                                <span class="text-white text-[9px] font-bold">@skill.ProficiencyLetter</span>
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full rounded-full flex items-center justify-center">
                                <span class="text-gray-400 text-[9px] font-bold">@skill.ProficiencyLetter</span>
                            </div>
                        }
                    </div>
                    <span class="text-xs w-7 text-right font-semibold @(skill.Modifier >= 0 ? "text-gray-100" : "text-red-400")">
                        @(skill.Modifier >= 0 ? "+" : "")@skill.Modifier
                    </span>
                    <span class="text-xs text-gray-300">@skill.Name</span>
                </div>
            }
        </div>
        </DraggableWidget>

        <!-- RIGHT: Main Character Panel -->
        <DraggableWidget WidgetId="weapons-gear" Title="Weapons & Gear" Subtitle="Weapons · Defense · Gear · Spells"
                         IsDragMode="@widgetMode" State="@widgetStates["weapons-gear"]" OnHide="HideWidget"
                         MaxHeight="600">
        <div class="@(widgetMode ? "" : "flex-1") flex flex-col min-w-0">

            <!-- Tab Buttons -->
            <div class="bg-gray-800 border-b border-gray-700 flex flex-wrap">
                @foreach (var tab in tabs)
                {
                    <button @onclick="() => SetActiveTab(tab)" class="@TabClass(tab)">
                        @tab
                    </button>
                }
            </div>

            <!-- Tab Content -->
            <div class="flex-1 p-4 bg-gray-900 lg:overflow-y-auto lg:max-h-[calc(100vh-190px)]">

                <!-- ─── WEAPONS ─────────────────────────────────────────── -->
                @if (activeTab == "Weapons")
                {
                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach (var cat in weaponCategories)
                        {
                            <button @onclick="() => ToggleWeaponCategory(cat.Key)"
                                    class="px-3 py-1.5 text-sm font-semibold rounded transition-colors flex items-center gap-1
                                           @(cat.Value ? "bg-amber-600 border-2 border-amber-600 text-white" : "bg-gray-800 border-2 border-gray-600 text-gray-300 hover:border-amber-500")">
                                <span>@(cat.Value ? "●" : "○")</span> @cat.Key
                            </button>
                        }
                    </div>

                    <button @onclick="() => showWeaponModal = true"
                            class="w-full border-2 border-dashed border-gray-600 hover:border-amber-500 text-amber-400 font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-gray-800">
                        + Add Weapon
                    </button>

                    @if (!weapons.Any())
                    {
                        <div class="text-center text-gray-400 text-sm py-8">No weapons equipped. Click "Add Weapon" to equip weapons.</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var (weapon, index) in weapons.Select((w, i) => (w, i)))
                            {
                                <div class="bg-gray-800 border border-gray-700 rounded p-3 flex flex-wrap items-center gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="font-bold text-sm text-gray-100">@weapon.Name</div>
                                        <div class="text-xs text-gray-300">@weapon.Traits</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold text-gray-100">@(weapon.AttackBonus >= 0 ? "+" : "")@weapon.AttackBonus</div>
                                        <div class="text-xs text-gray-300">Attack</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold text-gray-100">@weapon.Damage</div>
                                        <div class="text-xs text-gray-300">Damage</div>
                                    </div>
                                    <button @onclick="() => weapons.RemoveAt(index)" class="text-red-400 hover:text-red-300 text-sm px-2">✕</button>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-4 text-right">
                        <button class="text-sm text-gray-300 hover:text-amber-400 underline">Print</button>
                    </div>
                }

                else if (activeTab == "Defense")
                {
                    <!-- ─── DEFENSE ─────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-amber-400 mb-3">Defense</h3>

                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach (var cat in armorCategories)
                        {
                            <button @onclick="() => ToggleArmorCategory(cat.Key)"
                                    class="px-3 py-1.5 text-sm font-semibold rounded transition-colors
                                           @(cat.Value ? "bg-amber-600 border-2 border-amber-600 text-white" : "bg-gray-800 border-2 border-gray-600 text-gray-300 hover:border-amber-500")">
                                @cat.Key
                            </button>
                        }
                    </div>

                    <button @onclick="() => showArmorModal = true"
                            class="w-full border-2 border-dashed border-gray-600 hover:border-amber-500 text-amber-400 font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-gray-800">
                        + Add Armor / Shield
                    </button>

                    @if (!armors.Any())
                    {
                        <div class="text-center text-gray-400 text-sm py-8">No armor equipped. Click "Add Armor / Shield" to equip.</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var (armor, index) in armors.Select((a, i) => (a, i)))
                            {
                                <div class="bg-gray-800 border border-gray-700 rounded p-3 flex items-center gap-3">
                                    <div class="flex-1">
                                        <div class="font-bold text-sm text-gray-100">@armor.Name</div>
                                        <div class="text-xs text-gray-300">@armor.Category</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-lg font-bold text-gray-100">+@armor.ACBonus</div>
                                        <div class="text-xs text-gray-300">AC Bonus</div>
                                    </div>
                                    <button @onclick="() => armors.RemoveAt(index)" class="text-red-400 hover:text-red-300 text-sm px-2">✕</button>
                                </div>
                            }
                        </div>
                    }
                }

                else if (activeTab == "Gear")
                {
                    <!-- ─── GEAR ────────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-amber-400 mb-3">Gear & Equipment</h3>

                    <button @onclick="() => showGearModal = true"
                            class="w-full border-2 border-dashed border-gray-600 hover:border-amber-500 text-amber-400 font-semibold py-2 px-4 rounded text-left mb-4 transition-colors hover:bg-gray-800">
                        + Add Item
                    </button>

                    @if (!gearItems.Any())
                    {
                        <div class="text-center text-gray-400 text-sm py-8">No items in inventory.</div>
                    }
                    else
                    {
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-700 text-amber-400 text-left">
                                    <th class="pb-2 font-semibold">Item</th>
                                    <th class="pb-2 font-semibold text-center">Qty</th>
                                    <th class="pb-2 font-semibold text-center">Bulk</th>
                                    <th class="pb-2"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (item, index) in gearItems.Select((g, i) => (g, i)))
                                {
                                    <tr class="border-b border-gray-800 hover:bg-gray-800">
                                        <td class="py-2 font-medium text-gray-100">@item.Name</td>
                                        <td class="py-2 text-center text-gray-300">@item.Quantity</td>
                                        <td class="py-2 text-center text-gray-300">@item.Weight</td>
                                        <td class="py-2 text-right">
                                            <button @onclick="() => gearItems.RemoveAt(index)" class="text-red-400 hover:text-red-300">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="mt-3 text-sm text-right text-gray-300">
                            Total Bulk: <strong class="text-gray-100">@gearItems.Sum(i => i.Weight * i.Quantity)</strong>
                        </div>
                    }
                }

                else if (activeTab == "Spells")
                {
                    <!-- ─── SPELLS ───────────────────────────────────────────── -->
                    <h3 class="text-base font-bold text-amber-400 mb-3">Spells</h3>

                    @if (!spells.Any())
                    {
                        <div class="text-center text-gray-400 text-sm py-8">
                            <div class="text-4xl mb-3">✦</div>
                            <div>No spells prepared. This character has no spellcasting ability, or no spells have been added yet.</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var levelGroup in spells.GroupBy(s => s.Level).OrderBy(g => g.Key))
                        {
                            <div class="mb-4">
                                <div class="text-sm font-bold text-amber-400 mb-2 border-b border-gray-700 pb-1">
                                    @(levelGroup.Key == 0 ? "Cantrips" : $"Level {levelGroup.Key} Spells")

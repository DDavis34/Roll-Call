@page "/"

@rendermode InteractiveServer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Roll Call</title>
</head>
<body class="bg-gray-900 text-gray-100 font-sans text-center">
    <!-- Hero Section -->
    <section class="py-20 bg-linear-to-r from-gray-900 via-gray-800 to-gray-900">
        <h2 class="text-5xl font-extrabold mb-6 text-amber-400">Forge Your Legend</h2>
        <p class="text-lg text-gray-300 mb-8 max-w-2xl mx-auto">
            Create and customize your Pathfinder Adventures character with ease. Choose your class, race, skills, and equipment to begin your journey.
        </p>
        <a href="/CharacterSheet" class="bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 px-8 rounded-2xl shadow-lg transition">
            Start Creating
        </a>
    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto py-16 px-6 grid md:grid-cols-3 gap-10">
        <div class="bg-gray-800 p-6 rounded-2xl shadow-lg">
            <h3 class="text-xl font-semibold text-amber-400 mb-3">Custom Builds</h3>
            <p class="text-gray-300">Design characters with full control over stats, abilities, and backgrounds.</p>
        </div>
        <div class="bg-gray-800 p-6 rounded-2xl shadow-lg">
            <h3 class="text-xl font-semibold text-amber-400 mb-3">Save Progress</h3>
            <p class="text-gray-300">Store your characters and return anytime to continue building.</p>
        </div>
        <div class="bg-gray-800 p-6 rounded-2xl shadow-lg">
            <h3 class="text-xl font-semibold text-amber-400 mb-3">Export & Share</h3>
            <p class="text-gray-300">Export character sheets or share them with your party.</p>
        </div>
    </section>

    <!-- Prompt novice players to guide -->
    <section class="py-16 bg-gray-800">
        <h2 class="text-3xl font-bold text-amber-400 mb-4">Don't know where to start?</h2>
        <p class="text-gray-300 mb-6">If you're unfamiliar with Pathfinder, you can find our hand guides here.</p>
        <br/>
        <a href="/Tutorials" class="bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 px-6 rounded-xl">
            Tutorials
        </a>
    </section>
</body>
</html>

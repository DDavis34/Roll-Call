@page "/"
@using LumexUI
@using LumexUI.Common

@rendermode InteractiveServer

<PageTitle>Roll Call</PageTitle>
<div class="background-image">
    <!-- Hero Section -->
    <section class="hero-section py-24 text-center px-6">
        <h2 class="py-24 text-5xl font-extrabold mb-6 text-amber-400">Forge Your Legend</h2>
        <p class="text-lg text-gray-300 mb-8 max-w-2xl mx-auto">
            Create and customize your Pathfinder Adventures character with ease. Choose your class, race, skills, and equipment to begin your journey.
        </p>
        <a href="/create-character" class="hero-cta">
            Start Creating
        </a>
    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto py-16 px-6 grid md:grid-cols-3 gap-8">
        <LumexCard>
            <LumexCardHeader>
                <h3 class="text-xl font-semibold text-amber-400">Custom Builds</h3>
            </LumexCardHeader>
            <LumexCardBody>
                <p class="text-default-500">Design characters with full control over stats, abilities, and backgrounds.</p>
            </LumexCardBody>
        </LumexCard>

        <LumexCard>
            <LumexCardHeader>
                <h3 class="text-xl font-semibold text-amber-400">Save Progress</h3>
            </LumexCardHeader>
            <LumexCardBody>
                <p class="text-default-500">Store your characters and return anytime to continue building.</p>
            </LumexCardBody>
        </LumexCard>

        <LumexCard>
            <LumexCardHeader>
                <h3 class="text-xl font-semibold text-amber-400">Export &amp; Share</h3>
            </LumexCardHeader>
            <LumexCardBody>
                <p class="text-default-500">Export character sheets or share them with your party.</p>
            </LumexCardBody>
        </LumexCard>
    </section>

    <!-- Tutorials Section -->
    <section class="py-16 text-center px-6">
        <LumexCard Class="max-w-2xl mx-auto">
            <LumexCardHeader Class="flex flex-col items-center gap-1">
                <h2 class="text-3xl font-bold text-amber-400">Don't know where to start?</h2>
            </LumexCardHeader>
            <LumexCardBody Class="flex flex-col items-center gap-4">
                <p class="text-default-500">If you're unfamiliar with Pathfinder, you can find our hand guides here.</p>
                <a href="/Tutorials" class="hero-cta">
                    Tutorials
                </a>
            </LumexCardBody>
        </LumexCard>
    </section>
</div>

@page "/login"
@using PF2EGM.Services
@inject IApiAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Sign In</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <div class="brand">
            <div class="brand-mark">⬡</div>
            <h1>Welcome back</h1>
            <p class="subtitle">Sign in to continue</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                <div class="alert-icon">!</div>
                @errorMessage
            </div>
        }

        <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
            <div class="field">
                <label><span>Email</span></label>
                <input @bind="loginModel.Email" type="email"
                       placeholder="you@example.com" class="input" autocomplete="email" />
                @if (!string.IsNullOrEmpty(emailError))
                {
                    <span class="validation-message">@emailError</span>
                }
            </div>

            <div class="field">
                <label>
                    <span>Password</span>
                    <a href="/forgot-password" class="forgot-link">Forgot?</a>
                </label>
                <input @bind="loginModel.Password" type="password"
                       placeholder="••••••••" class="input" autocomplete="current-password" />
                @if (!string.IsNullOrEmpty(passwordError))
                {
                    <span class="validation-message">@passwordError</span>
                }
            </div>

            <button type="submit" class="btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </form>

        <div class="divider">or</div>

        <button type="button" class="btn-oauth" @onclick="HandleGoogleLogin">
            <svg width="18" height="18" viewBox="0 0 18 18" class="shrink-0">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.348 2.825.957 4.039l3.007-2.332z"/>
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
            </svg>
            Continue with Google
        </button>

        <p class="signup-prompt">
            Don't have an account? <a href="/register">Create one</a>
        </p>
    </div>
</div>

@code {
    private LoginModel loginModel { get; set; } = new();

    private string? errorMessage;
    private string? emailError;
    private string? passwordError;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        emailError = null;
        passwordError = null;

        if (string.IsNullOrEmpty(loginModel.Email))
            emailError = "Email is required";
        else if (!loginModel.Email.Contains('@'))
            emailError = "Enter a valid email";

        if (string.IsNullOrEmpty(loginModel.Password))
            passwordError = "Password is required";

        if (emailError != null || passwordError != null)
        {
            isLoading = false;
            return;
        }

        try
        {
            var result = await AuthService.SignInAsync(loginModel.Email, loginModel.Password);
            if (result.IsSuccess)
                Nav.NavigateTo("/dashboard");
            else
                errorMessage = result.ErrorMessage ?? "Invalid email or password.";
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong. Please try again.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        var url = await AuthService.GetOAuthUrlAsync("google");
        Nav.NavigateTo(url, forceLoad: true);
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}

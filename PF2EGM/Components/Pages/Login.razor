@page "/login"
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using PF2EGM.Services
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@inject IApiAuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Sign In</PageTitle>

<div class="login-wrapper">
    <LumexCard Class="login-card">
        <LumexCardHeader Class="flex flex-col items-center gap-1 pb-2">
            <div class="brand-mark">
                <svg viewBox="0 0 52 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="26,2 50,15 50,45 26,58 2,45 2,15"
                             fill="rgba(217,119,6,0.15)" stroke="#f59e0b" stroke-width="2.5" stroke-linejoin="round"/>
                    <polygon points="26,10 42,19 42,41 26,50 10,41 10,19"
                             fill="rgba(245,158,11,0.1)" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round"/>
                    <text x="26" y="35" text-anchor="middle" font-size="16" font-weight="bold" fill="#fbbf24" font-family="Georgia,serif">RC</text>
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Welcome back</h1>
            <p class="text-sm text-default-500">Sign in to continue</p>
        </LumexCardHeader>

        <LumexCardBody Class="gap-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="flex items-center gap-2 rounded-xl bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger">
                    <span class="shrink-0 font-bold">!</span>
                    @errorMessage
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                <DataAnnotationsValidator />

                <div class="flex flex-col gap-4">
                    <LumexTextbox @bind-Value="loginModel.Email"
                                  Type="@InputType.Email"
                                  Label="Email"
                                  Placeholder="you@example.com"
                                  Variant="@InputVariant.Flat"
                                  LabelPlacement="@LabelPlacement.Inside"
                                  Required="@true"
                                  ErrorMessage="@emailError"
                                  Invalid="@(!string.IsNullOrEmpty(emailError))" />

                    <div class="flex flex-col gap-1">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-medium text-default-600">Password</span>
                            <a href="/forgot-password" class="text-xs text-amber-400 hover:text-amber-300 transition-colors">Forgot?</a>
                        </div>
                        <LumexTextbox @bind-Value="loginModel.Password"
                                      Type="@InputType.Password"
                                      Placeholder="••••••••"
                                      Variant="@InputVariant.Flat"
                                      ErrorMessage="@passwordError"
                                      Invalid="@(!string.IsNullOrEmpty(passwordError))" />
                    </div>

                    <LumexButton Type="@ButtonType.Submit"
                                 Color="@ThemeColor.Primary"
                                 Class="w-full"
                                 Disabled="@isLoading">
                        @if (isLoading)
                        {
                            <LumexSpinner Size="@Size.Small" Color="@ThemeColor.Primary" />
                            <span>Signing in…</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                        }
                    </LumexButton>
                </div>
            </EditForm>

            <div class="flex items-center gap-3">
                <LumexDivider Class="flex-1" />
                <span class="text-xs text-default-400">or</span>
                <LumexDivider Class="flex-1" />
            </div>

            <LumexButton Variant="@Variant.Outlined"
                         Color="@ThemeColor.Primary"
                         Class="w-full"
                         OnClick="HandleGoogleLogin">
                <svg width="18" height="18" viewBox="0 0 18 18" class="shrink-0">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.348 2.825.957 4.039l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
                </svg>
                Continue with Google
            </LumexButton>
        </LumexCardBody>

        <LumexCardFooter Class="justify-center pt-0">
            <p class="text-sm text-default-500">
                Don't have an account?
                <a href="/register" class="text-amber-400 font-medium hover:text-amber-300 transition-colors">Create one</a>
            </p>
        </LumexCardFooter>
    </LumexCard>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new();

    private string? errorMessage;
    private string? emailError;
    private string? passwordError;
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        loginModel ??= new();
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        emailError = null;
        passwordError = null;

        if (string.IsNullOrEmpty(loginModel.Email))
            emailError = "Email is required";
        else if (!loginModel.Email.Contains('@'))
            emailError = "Enter a valid email";

        if (string.IsNullOrEmpty(loginModel.Password))
            passwordError = "Password is required";

        if (emailError != null || passwordError != null)
        {
            isLoading = false;
            return;
        }

        try
        {
            var result = await AuthService.SignInAsync(loginModel.Email, loginModel.Password);

            if (result.IsSuccess)
            {
                AuthState.UserEmail = loginModel.Email;
                AuthState.NotifyStateChanged();
                Nav.NavigateTo("/");
            }
            else
                errorMessage = result.ErrorMessage ?? "Invalid email or password.";
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong. Please try again.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        var url = await AuthService.GetOAuthUrlAsync("google");
        Nav.NavigateTo(url, forceLoad: true);
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";
    }
}
@page "/Tutorials/Character-Creation-Basics"
@using PF2EGM.Components.Pages.Tutorials.TutorialComponents

<PageTitle>Character Creation Basics</PageTitle>

<div class="background-image text-gray-100 min-h-screen font-sans">

    <!-- Header -->
    <section class="text-center px-2 py-12">
        <h2 class="text-4xl font-extrabold text-amber-400 mb-4">Character Creation Guide</h2>
        <p class="text-gray-300 max-w-2xl mx-auto">
            Learn the fundamentals of building an effective Pathfinder character.
        </p>
    </section>

    <div class="max-w-6xl mx-auto p-2 sm:p-6 pb-16 space-y-12">

        <!-- Gameplay Basics -->
        <section class="bg-gray-800 rounded-2xl p-4 sm:p-8">
            <h3 class="text-2xl text-center font-semibold text-amber-400 mb-4">Gameplay Basics</h3>
            <p class="mb-4">
                Pathfinder revolves around strategic combat, character progression, and teamwork. Understanding how turns, actions, and dice rolls work is essential.
            </p>
            <ul class="list-disc list-inside text-gray-300 space-y-2">
                <li>Each turn consists of actions and movement</li>
                <li>Dice rolls determine success or failure</li>
                <li>Team composition impacts survivability</li>
            </ul>

            <!-- Video Placeholder -->
            <YouTubeEmbed Src="link" Title="Title"/>
        </section>

        <!-- Character Considerations -->
        <section class="bg-gray-800 rounded-2xl p-4 sm:p-8">
            <h3 class="text-2xl text-center font-semibold text-amber-400 mb-4">Character Creation Considerations</h3>
            <p class="text-gray-300 mb-4">
                When creating your character, think about how your choices will affect gameplay and synergy with your party.
            </p>
            <ul class="list-disc list-inside text-gray-300 space-y-2">
                <li>Choose a class that fits your preferred playstyle</li>
                <li>Balance attributes based on your role</li>
                <li>Consider long-term progression and abilities</li>
            </ul>

            <!-- Video Placeholder -->
            <YouTubeEmbed Src="Link" Title="Video Name"/>
        </section>

        <!-- Quick Tips -->
        <section class="bg-gray-800 rounded-2xl p-4 sm:p-8">
            <h3 class="text-2xl text-center font-semibold text-amber-400 mb-4">Quick Tips</h3>
            <ul class="list-disc list-inside text-gray-300 space-y-2">
                <li>Don’t min-max too early—balance matters</li>
                <li>Keep your gear updated regularly</li>
                <li>Read ability descriptions carefully</li>
                <li>Experiment with different builds</li>
            </ul>

            <!-- Video Placeholder -->
            <YouTubeEmbed Src="link" Title="Title"/>
        </section>

    </div>

    <TutorialButton Message2="Understanding Attributes" Link2="/Tutorials/Understanding-Attributes"/>

</div>

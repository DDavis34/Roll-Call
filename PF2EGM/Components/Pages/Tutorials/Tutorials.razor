@page "/Tutorials"

<PageTitle>Tutorials</PageTitle>

<div class="background-image text-gray-100 min-h-screen font-sans">

    <!-- Header -->
    <section class="text-center py-16">
        <h2 class="text-4xl font-extrabold text-amber-400 mb-4">Tutorials & Guides</h2>
        <p class="text-gray-300 max-w-2xl mx-auto">
            Learn how to build your character, understand mechanics, and master Pathfinder Adventures.
        </p>
    </section>

    <!-- Tutorials Grid -->
    <section class="max-w-7xl mx-auto px-6 pb-16 grid md:grid-cols-2 lg:grid-cols-3 gap-8 text-center">

        @foreach (var tutorial in tutorials)
        {
            <div class="bg-gray-800 rounded-2xl shadow-lg p-6 hover:shadow-xl transition">
                <h3 class="text-xl font-semibold text-amber-400 mb-2">@tutorial.Title</h3>
                <p class="text-gray-300 mb-4">@tutorial.Description</p>

                <!-- Tutorial Selection Button -->
                <a href="@tutorial.Link">
                    <button class="w-full bg-amber-500 hover:bg-amber-600 text-gray-900 font-semibold py-2 px-4 rounded-xl transition">
                        View Tutorial
                    </button>
                </a>
            </div>
        }

    </section>

    <!-- Featured Tutorial Section -->
    <section class="bg-gray-800 py-16 border-t border-gray-700">
        <div class="max-w-5xl mx-auto text-center px-6">
            <h2 class="text-3xl font-bold text-amber-400 mb-4">Gamemastering</h2>
            <p class="text-gray-300 mb-6">
                New to being a Game Master (GM) or need additional help in running a campaign? Start here to learn the basics of world-setting and narrating the story.
            </p>

            <button class="bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 px-8 rounded-2xl shadow-lg transition">
                Start Beginner Guide
            </button>
        </div>
    </section>

</div>

@code {
    List<Tutorial> tutorials = new()
    {
        new Tutorial { Title = "Character Creation Basics", Description = "Learn how to build your first character step-by-step.", Link = "/Tutorials/Character-Creation-Basics" },
        new Tutorial { Title = "Understanding Attributes", Description = "Breakdown of Strength, Dexterity, and more.", Link = "/Tutorials/Understanding-Attributes" },
        new Tutorial { Title = "Choosing ABCs", Description = "Find the ancestry, background, and class that fits your playstyle.", Link = "/Tutorials/Choosing-ABCs" },
        new Tutorial { Title = "Equipment & Gear", Description = "How to properly equip your character.", Link = "/Tutorials/Equipment-&-Gear" },
        new Tutorial { Title = "Combat Mechanics", Description = "Learn how combat works in Pathfinder.", Link = "/Tutorials/Combat-Mechanics" },
        new Tutorial { Title = "Spellcasting Guide", Description = "Master spells and magical abilities.", Link = "/Tutorials/Spellcasting-Guide" }
    };

    public class Tutorial
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Link { get; set; } = "";
    }
}

@code {
    [Parameter] public string Message1 { get; set; } = "Back to Tutorials";
    [Parameter] public string Link1 { get; set; } = "/tutorials";
    [Parameter] public bool ShowFirstButton { get; set; } = true;

    [Parameter] public string Message2 { get; set; } = "";
    [Parameter] public string Link2 { get; set; } = "/";
    [Parameter] public bool ShowSecondButton { get; set; } = true;
}

<section class="max-w-6xl mx-auto pb-16 px-6">
    <div>
        @if (ShowFirstButton)
        {
            <a href="@Link1">
                <button class="w-full bg-amber-500 hover:bg-amber-600 text-gray-900 font-semibold my-4 py-2 px-4 rounded-xl transition">
                    @Message1
                </button>
            </a>
        }
        @if (ShowSecondButton)
        {
            <a href="@Link2">
                <button class="w-full bg-amber-500 hover:bg-amber-600 text-gray-900 font-semibold my-4 py-2 px-4 rounded-xl transition">
                    Suggested: @Message2
                </button>
            </a>
        }
    </div>
</section>